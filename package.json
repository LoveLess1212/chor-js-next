{
  "name": "chor-js",
  "version": "0.7.1",
  "description": "A BPMN 2.0 choreography diagram rendering toolkit and web modeler.",
  "keywords": [
    "choreography model",
    "choreography",
    "modeler",
    "browser",
    "choreo-js",
    "toolkit",
    "bpmn"
  ],
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist",
    "lib"
  ],
  "sideEffects":[
    "*.css"
  ],
  "scripts": {
    "lint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "test": "karma start test/config/karma.unit.js",
    "demo:local": "node scripts/serve-demo.mjs",
    "bundle": "npm run distro",
    "prepublishOnly": "npm run bundle",
    "visualTest": "node ./test/testBundler.js",
    "distro": "node tasks/build-distro.mjs"
  },
  "author": {
    "name": "Jan Ladleif",
    "url": "https://github.com/jan-ladleif"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bptlab/chor-js"
  },
  "assetTypesToStringify": [
    "bpmn"
  ],
  "browserslist": [
    "last 2 Firefox versions",
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "last 2 Opera versions",
    "last 2 Baidu versions"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "bpmn-font": "^0.12.1",
    "chai": "^6.2.2",
    "chai-match": "^1.1.1",
    "cpy": "^13.2.2",
    "del": "^8.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-bpmn-io": "^2.3.1",
    "execa": "^9.6.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher-2": "^3.3.0",
    "karma-coverage": "^2.2.0",
    "karma-debug-launcher": "^0.0.5",
    "karma-env-preprocessor": "^0.1.1",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-safari-launcher": "^1.0.0",
    "karma-tldr-reporter": "^0.0.1",
    "karma-webpack": "^5.0.1",
    "mocha": "^11.0.0",
    "mocha-test-container-support": "0.2.0",
    "puppeteer": "^3.3.0",
    "rollup": "^4.61.1",
    "rollup-plugin-license": "^3.7.1",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "source-map-support": "^0.5.19"
  },
  "dependencies": {
    "bpmn-js": "^18.19.0",
    "bpmn-moddle": "^10.0.0",
    "diagram-js": "^15.18.0",
    "diagram-js-direct-editing": "^3.4.0",
    "ids": "^3.0.2",
    "inherits": "^2.0.4",
    "inherits-browser": "^0.1.0",
    "min-dash": "^5.0.0",
    "min-dom": "^5.3.0",
    "tiny-svg": "^4.1.4",
    "webpack": "^5.108.3"
  }
}
